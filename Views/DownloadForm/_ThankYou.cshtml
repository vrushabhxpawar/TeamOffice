@{
    var link = ViewBag.link;
}

<div class="text-center mt-5">
    <div class="p-4 rounded-4 border bg-light mt-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size:70px;"></i>

        <h3 class="mb-2">
            Your download is ready!
        </h3>

        <p class="text-muted mb-4">
            Click the button below to download the TeamOffice software.
        </p>

        <a href="@link"
           class="btn btn-primary px-4">
            <i class="bi bi-download me-2"></i>
            Download
        </a>

        <hr class="my-4">

        <a href="https://www.etimeoffice.com/"
           class="text-decoration-none d-inline-flex align-items-center">
            Visit TeamOffice Home
            <i class="bi bi-arrow-up-right ms-2"></i>
        </a>
    </div>
</div>
